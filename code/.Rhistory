gse   <- getGEO("GSE51808", GSEMatrix = TRUE)[[1]]   # change if you chose another
expr  <- exprs(gse)
meta  <- pData(gse)
fdata <- fData(gse)
dim(expr)
if (max(expr, na.rm = TRUE) > 50) expr <- log2(expr + 1)   # log-transform if raw
cat("Missing values:", sum(is.na(expr)), "\n")
boxplot(expr, las = 2, cex.axis = 0.5, main = "Before normalisation")
graphics.off()
if (max(expr, na.rm = TRUE) > 50) expr <- log2(expr + 1)
cat("Missing values:", sum(is.na(expr)), "\n")
par(mar = c(6, 4, 3, 1))
boxplot(as.data.frame(expr), las = 2, cex.axis = 0.5,
main = "Before normalisation", ylab = "log2 expression")
expr <- normalizeBetweenArrays(expr, method = "quantile")
par(mar = c(6, 4, 3, 1))
boxplot(as.data.frame(expr), las = 2, cex.axis = 0.5,
main = "After normalisation", ylab = "log2 expression")
expr <- normalizeBetweenArrays(expr, method = "quantile")
