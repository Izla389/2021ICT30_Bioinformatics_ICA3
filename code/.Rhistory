colnames(meta)
head(meta[, 1:6])
table(meta$title)
meta$group <- case_when(
str_detect(meta$title, "DHF") ~ "DHF",
str_detect(meta$title, "DF")  ~ "DF",
TRUE ~ "Other")
table(meta$group)
keep <- meta$group %in% c("DF", "DHF")
expr <- expr[, keep]; meta <- meta[keep, ]
table(meta$group)
